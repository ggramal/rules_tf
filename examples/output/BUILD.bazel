load(
    "@rules_tf//tf:defs.bzl",
    "tf_apply",
    "tf_init",
    "tf_plan",
    "tf_output",
    "tf_binary",
)
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "*.tf",
        ],
    ) + [
        #You have to create this
        #file if it doesnt exist
        "this.tfstate",
    ],
    visibility = ["//visibility:public"],
)

tf_init(
    name = "init",
    srcs = [
        "main.tf",
    ],
)

tf_output(
    name = "output",
    init = ":init",
    std_out = True,
    srcs = [
        ":srcs",
    ],
)

tf_plan(
    name = "plan",
    srcs = [
        ":srcs",
    ],
    init = ":init",
    #We do not lock here
    #because build rules run
    #in sandbox environments
    #in which files are immutable
    lock = False,
    parallelism = "100",
)

tf_apply(
    name = "apply",
    srcs = [
        ":srcs",
    ],
    init = ":init",
    plan = ":plan",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "show_output",
    srcs = [
        "output.sh",
    ],
    env = {
        "TF_OUTPUT_FILE": "$(rootpath :output)",
    },
    data = [
        ":output"
    ]
)

tf_binary(
    name = "tf",
    srcs = [":srcs"],
    init = ":init",
)
